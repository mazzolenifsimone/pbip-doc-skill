{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pbip-doc-skill Configuration",
  "description": "Configuration settings for PBIP model parsing and documentation generation.",
  "exclude_auto_date_tables": true,
  "excluded_table_patterns": [
    "^LocalDateTable_.*",
    "^DateTableTemplate_.*",
    "^LocalDateTable\\b.*"
  ],
  "excluded_tables": [],
  "include_inherited_entities": false,
  "include_table_yaml_frontmatter": true,
  "include_table_topology_section": true,
  "include_table_lineage_section": true,
  "include_table_incremental_refresh": true,
  "include_table_columns_dictionary": true,
  "include_table_relationships_section": true,
  "include_table_snowflake_paths": true,
  "include_table_measures_list": true,
  "include_table_m_code": true,
  "include_table_rag_hints": true,
  "include_measure_yaml_frontmatter": true,
  "include_measure_dax_formula": true,
  "include_measure_upstream_deps": true,
  "include_measure_downstream_impact": true,
  "include_measure_referenced_columns": true,
  "include_measure_rag_hints": true,
  "include_function_yaml_frontmatter": true,
  "include_function_parameters_section": true,
  "include_function_formula_section": true,
  "include_function_downstream_section": true,
  "include_function_rag_hints": true,
  "include_expression_docs": true,
  "include_expression_yaml_frontmatter": true,
  "include_expression_overview_section": true,
  "include_expression_inline_table": true,
  "include_expression_lineage_section": true,
  "include_expression_steps_section": true,
  "include_expression_m_code": true,
  "include_expression_rag_hints": true,
  "output_dir": "docs",
  "tables_subdir": "tables",
  "measures_subdir": "measures",
  "functions_subdir": "functions",
  "expressions_subdir": "expressions",
  "generate_index_file": true,
  "sanitize_filenames": true,
  "include_markdown_links": true
}
